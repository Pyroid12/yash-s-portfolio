# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address (must be a verified domain/email in Resend for production)
# Example: "Yash Rendalkar <onboarding@resend.dev>" for Resend sandbox testing
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production canonical URL (e.g. https://your-domain.vercel.app or custom domain)
NEXT_PUBLIC_SITE_URL=
